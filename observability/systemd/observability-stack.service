[Unit]
Description=Phase 4 Observability Stack
Wants=network-online.target
Requires=docker.service
After=network-online.target docker.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/observability-stack
Environment=COMPOSE_PARALLEL_LIMIT=3
UMask=0027
ExecStartPre=/usr/bin/docker compose config --quiet
ExecStart=/usr/bin/docker compose up --detach --remove-orphans --wait --wait-timeout 300
ExecReload=/usr/bin/docker compose up --detach --remove-orphans --wait --wait-timeout 300
ExecStop=/usr/bin/docker compose down --remove-orphans --timeout 60
TimeoutStartSec=600
TimeoutStopSec=180
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
