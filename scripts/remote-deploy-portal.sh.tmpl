# shellcheck shell=sh
set -eu
export DEBIAN_FRONTEND=noninteractive
REGION="__REGION__"
ELASTIC_SECRET_ID="__ELASTIC_SECRET_ID__"
PORTAL_PORT="__PORTAL_PORT__"
ENABLE_ELASTIC_PEER_PROXY="__ENABLE_ELASTIC_PEER_PROXY__"
PORTAL_AUTH_MODE="__PORTAL_AUTH_MODE__"
PORTAL_HTTPS_MODE="__PORTAL_HTTPS_MODE__"
PORTAL_PUBLIC_URL="__PORTAL_PUBLIC_URL__"
PORTAL_OIDC_ISSUER_URL="__PORTAL_OIDC_ISSUER_URL__"
PORTAL_OIDC_SECRET_ID="__PORTAL_OIDC_SECRET_ID__"
PORTAL_OIDC_ALLOWED_GROUP="__PORTAL_OIDC_ALLOWED_GROUP__"
PORTAL_OIDC_GROUPS_CLAIM="__PORTAL_OIDC_GROUPS_CLAIM__"
ENABLE_VAULT_DIRECT="__ENABLE_VAULT_DIRECT__"
VAULT_ADDR="__VAULT_ADDR__"
VAULT_ROLE_ID_SECRET_ID="__VAULT_ROLE_ID_SECRET_ID__"
VAULT_SECRET_ID_SECRET_ID="__VAULT_SECRET_ID_SECRET_ID__"
VAULT_NAMESPACE="__VAULT_NAMESPACE__"
VAULT_APPROLE_AUTH_MOUNT="__VAULT_APPROLE_AUTH_MOUNT__"
VAULT_PKI_MOUNT="__VAULT_PKI_MOUNT__"
VAULT_LEASE_PREFIX="__VAULT_LEASE_PREFIX__"
VAULT_TIMEOUT_SECONDS="__VAULT_TIMEOUT_SECONDS__"
INSTALL_DIR="/opt/security-portal"
SECRET_FILE=""
COMPOSE_DOWNLOAD=""
OIDC_SECRET_JSON=""

# shellcheck disable=SC2329
cleanup() {
  if [ -n "$SECRET_FILE" ]; then
    rm -f "$SECRET_FILE"
  fi
  if [ -n "$COMPOSE_DOWNLOAD" ]; then
    rm -f "$COMPOSE_DOWNLOAD"
  fi
}
trap cleanup EXIT

apt-get update
apt-get install -y docker.io jq curl ca-certificates

if ! docker compose version >/dev/null 2>&1; then
  if ! apt-get install -y docker-compose-v2; then
    install -d -m 0755 /usr/local/lib/docker/cli-plugins /usr/libexec/docker/cli-plugins
    ARCH="$(uname -m)"
    case "$ARCH" in
      aarch64|arm64)
        COMPOSE_ARCH="aarch64"
        COMPOSE_SHA256="d26373b19e89160546d15407516cc59f453030d9bc5b43ba7faf16f7b4980137"
        ;;
      x86_64|amd64)
        COMPOSE_ARCH="x86_64"
        COMPOSE_SHA256="dba9d98e1ba5bfe11d88c99b9bd32fc4a0624a30fafe68eea34d61a3e42fd372"
        ;;
      *) echo "Unsupported Docker Compose architecture: ${ARCH:-unknown}" >&2; exit 1 ;;
    esac
    COMPOSE_DOWNLOAD="$(mktemp /tmp/docker-compose.XXXXXX)"
    curl -fsSL "https://github.com/docker/compose/releases/download/v2.40.3/docker-compose-linux-$COMPOSE_ARCH" -o "$COMPOSE_DOWNLOAD"
    printf '%s  %s\n' "$COMPOSE_SHA256" "$COMPOSE_DOWNLOAD" | sha256sum -c - >/dev/null
    install -m 0755 "$COMPOSE_DOWNLOAD" /usr/local/lib/docker/cli-plugins/docker-compose
    rm -f "$COMPOSE_DOWNLOAD"
    COMPOSE_DOWNLOAD=""
    ln -sf /usr/local/lib/docker/cli-plugins/docker-compose /usr/libexec/docker/cli-plugins/docker-compose
  fi
fi

systemctl enable --now docker
mkdir -p "$INSTALL_DIR"
rm -rf "${INSTALL_DIR:?}"/*
tar -xzf /tmp/security-portal-runtime.tar.gz -C "$INSTALL_DIR"

BACKEND_AUTH_MODE="$PORTAL_AUTH_MODE"
COMPOSE_PROFILES=""
PORTAL_AUTH_REQUEST="off"
PORTAL_API_EMAIL='""'
PORTAL_API_GROUPS='""'
PORTAL_PRIVILEGED_EMAIL='""'
PORTAL_PRIVILEGED_GROUPS='""'

case "$PORTAL_AUTH_MODE" in
  deny)
    BACKEND_AUTH_MODE="deny"
    ;;
  trusted_headers)
    BACKEND_AUTH_MODE="trusted_headers"
    PORTAL_PRIVILEGED_EMAIL='"portal-ui@lab.local"'
    PORTAL_PRIVILEGED_GROUPS='"SECURITY_ANALYST"'
    ;;
  oidc)
    if [ "$PORTAL_HTTPS_MODE" != "alb" ] || [ -z "$PORTAL_PUBLIC_URL" ]; then
      echo "OIDC deployment requires an HTTPS ALB public URL" >&2
      exit 1
    fi
    BACKEND_AUTH_MODE="trusted_headers"
    COMPOSE_PROFILES="oidc"
    PORTAL_AUTH_REQUEST="/oauth2/auth"
    # These are literal Nginx variables inserted into the rendered configuration.
    # shellcheck disable=SC2016
    PORTAL_API_EMAIL='$auth_user_email'
    # shellcheck disable=SC2016
    PORTAL_API_GROUPS='$auth_user_groups'
    # shellcheck disable=SC2016
    PORTAL_PRIVILEGED_EMAIL='$auth_user_email'
    # shellcheck disable=SC2016
    PORTAL_PRIVILEGED_GROUPS='$auth_user_groups'
    ;;
  *)
    echo "Unsupported portal authentication mode" >&2
    exit 1
    ;;
esac

PORTAL_AUTH_REQUEST="$PORTAL_AUTH_REQUEST" \
PORTAL_API_EMAIL="$PORTAL_API_EMAIL" \
PORTAL_API_GROUPS="$PORTAL_API_GROUPS" \
PORTAL_PRIVILEGED_EMAIL="$PORTAL_PRIVILEGED_EMAIL" \
PORTAL_PRIVILEGED_GROUPS="$PORTAL_PRIVILEGED_GROUPS" \
python3 - "$INSTALL_DIR/nginx.conf" <<'PY'
import os
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
replacements = {
    "__PORTAL_AUTH_REQUEST__": os.environ["PORTAL_AUTH_REQUEST"],
    "__PORTAL_API_EMAIL__": os.environ["PORTAL_API_EMAIL"],
    "__PORTAL_API_GROUPS__": os.environ["PORTAL_API_GROUPS"],
    "__PORTAL_PRIVILEGED_EMAIL__": os.environ["PORTAL_PRIVILEGED_EMAIL"],
    "__PORTAL_PRIVILEGED_GROUPS__": os.environ["PORTAL_PRIVILEGED_GROUPS"],
}
for marker, value in replacements.items():
    if marker not in text:
        raise SystemExit(f"missing Nginx template marker: {marker}")
    text = text.replace(marker, value)
if "__PORTAL_" in text:
    raise SystemExit("unresolved portal marker remains in Nginx configuration")
temporary = path.with_suffix(".conf.tmp")
temporary.write_text(text, encoding="utf-8")
temporary.replace(path)
PY

SECRET_JSON="$(aws secretsmanager get-secret-value --region "$REGION" --secret-id "$ELASTIC_SECRET_ID" --query SecretString --output text)"
ELASTIC_USERNAME="$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_username // empty')"
ELASTIC_PASSWORD="$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_password // empty')"
FILEBEAT_API_KEY="$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_filebeat_ingest_api_key // empty')"
FILEBEAT_READ_API_KEY="$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_filebeat_read_api_key // empty')"
SECRET_CHANGED=false

if [ -z "$ELASTIC_USERNAME" ] || [ -z "$ELASTIC_PASSWORD" ]; then
  echo "Elastic bootstrap credentials are missing from Secrets Manager" >&2
  exit 1
fi

install -d -m 0700 "$INSTALL_DIR/secrets"
: > "$INSTALL_DIR/secrets/oidc-client-secret"
: > "$INSTALL_DIR/secrets/oidc-cookie-secret"
chmod 600 \
  "$INSTALL_DIR/secrets/oidc-client-secret" \
  "$INSTALL_DIR/secrets/oidc-cookie-secret"
chown 65532:65532 \
  "$INSTALL_DIR/secrets/oidc-client-secret" \
  "$INSTALL_DIR/secrets/oidc-cookie-secret"

if [ "$PORTAL_AUTH_MODE" = "oidc" ]; then
  OIDC_SECRET_JSON="$(aws secretsmanager get-secret-value \
    --region "$REGION" \
    --secret-id "$PORTAL_OIDC_SECRET_ID" \
    --query SecretString \
    --output text)"
  OIDC_CLIENT_ID="$(printf '%s' "$OIDC_SECRET_JSON" | jq -r '.client_id // empty')"
  OIDC_CLIENT_SECRET="$(printf '%s' "$OIDC_SECRET_JSON" | jq -r '.client_secret // empty')"
  OIDC_COOKIE_SECRET="$(printf '%s' "$OIDC_SECRET_JSON" | jq -r '.cookie_secret // empty')"

  case "$OIDC_CLIENT_ID" in
    ""|*[!A-Za-z0-9._:-]*)
      echo "OIDC client_id is missing or contains unsupported characters" >&2
      exit 1
      ;;
  esac
  if [ -z "$OIDC_CLIENT_SECRET" ] || [ -z "$OIDC_COOKIE_SECRET" ]; then
    echo "OIDC client_secret and cookie_secret are required in Secrets Manager" >&2
    exit 1
  fi
  if [ "$(printf '%s' "$OIDC_CLIENT_SECRET" | wc -l)" -ne 0 ]; then
    echo "OIDC client_secret must be a single line" >&2
    exit 1
  fi

  printf '%s' "$OIDC_CLIENT_SECRET" > "$INSTALL_DIR/secrets/oidc-client-secret"
  COOKIE_SECRET_STANDARD_B64="$(printf '%s' "$OIDC_COOKIE_SECRET" | tr -- '_-' '/+')"
  case $(( ${#COOKIE_SECRET_STANDARD_B64} % 4 )) in
    2) COOKIE_SECRET_STANDARD_B64="${COOKIE_SECRET_STANDARD_B64}==" ;;
    3) COOKIE_SECRET_STANDARD_B64="${COOKIE_SECRET_STANDARD_B64}=" ;;
    0) ;;
    *)
      echo "OIDC cookie_secret is not valid base64" >&2
      exit 1
      ;;
  esac
  if ! printf '%s' "$COOKIE_SECRET_STANDARD_B64" | base64 -d > "$INSTALL_DIR/secrets/oidc-cookie-secret"; then
    echo "OIDC cookie_secret is not valid base64" >&2
    exit 1
  fi
  COOKIE_SECRET_BYTES="$(wc -c < "$INSTALL_DIR/secrets/oidc-cookie-secret" | tr -d ' ')"
  case "$COOKIE_SECRET_BYTES" in
    16|24|32) ;;
    *)
      echo "OIDC cookie_secret must decode to exactly 16, 24, or 32 bytes" >&2
      exit 1
      ;;
  esac
  chmod 600 "$INSTALL_DIR/secrets/oidc-client-secret" "$INSTALL_DIR/secrets/oidc-cookie-secret"
  chown 65532:65532 "$INSTALL_DIR/secrets/oidc-client-secret" "$INSTALL_DIR/secrets/oidc-cookie-secret"

  {
    printf 'OAUTH2_PROXY_PROVIDER=%s\n' 'keycloak-oidc'
    printf 'OAUTH2_PROXY_CLIENT_ID=%s\n' "$OIDC_CLIENT_ID"
    printf 'OAUTH2_PROXY_CLIENT_SECRET_FILE=%s\n' '/run/secrets/oidc-client-secret'
    printf 'OAUTH2_PROXY_COOKIE_SECRET_FILE=%s\n' '/run/secrets/oidc-cookie-secret'
    printf 'OAUTH2_PROXY_OIDC_ISSUER_URL=%s\n' "$PORTAL_OIDC_ISSUER_URL"
    printf 'OAUTH2_PROXY_REDIRECT_URL=%s\n' "$PORTAL_PUBLIC_URL/oauth2/callback"
    printf 'OAUTH2_PROXY_ALLOWED_GROUPS=%s\n' "$PORTAL_OIDC_ALLOWED_GROUP"
    printf 'OAUTH2_PROXY_OIDC_GROUPS_CLAIM=%s\n' "$PORTAL_OIDC_GROUPS_CLAIM"
    printf 'OAUTH2_PROXY_SCOPE=%s\n' 'openid profile email groups'
    printf 'OAUTH2_PROXY_EMAIL_DOMAINS=%s\n' '*'
    printf 'OAUTH2_PROXY_UPSTREAMS=%s\n' 'static://202'
    printf 'OAUTH2_PROXY_HTTP_ADDRESS=%s\n' '0.0.0.0:4180'
    printf 'OAUTH2_PROXY_CODE_CHALLENGE_METHOD=%s\n' 'S256'
    printf 'OAUTH2_PROXY_INSECURE_OIDC_ALLOW_UNVERIFIED_EMAIL=%s\n' 'false'
    printf 'OAUTH2_PROXY_INSECURE_OIDC_SKIP_ISSUER_VERIFICATION=%s\n' 'false'
    printf 'OAUTH2_PROXY_INSECURE_OIDC_SKIP_NONCE=%s\n' 'false'
    printf 'OAUTH2_PROXY_SSL_INSECURE_SKIP_VERIFY=%s\n' 'false'
    printf 'OAUTH2_PROXY_REVERSE_PROXY=%s\n' 'true'
    printf 'OAUTH2_PROXY_FORCE_HTTPS=%s\n' 'true'
    printf 'OAUTH2_PROXY_SET_XAUTHREQUEST=%s\n' 'true'
    printf 'OAUTH2_PROXY_SKIP_AUTH_STRIP_HEADERS=%s\n' 'true'
    printf 'OAUTH2_PROXY_PASS_ACCESS_TOKEN=%s\n' 'false'
    printf 'OAUTH2_PROXY_PASS_AUTHORIZATION_HEADER=%s\n' 'false'
    printf 'OAUTH2_PROXY_SET_AUTHORIZATION_HEADER=%s\n' 'false'
    printf 'OAUTH2_PROXY_PASS_BASIC_AUTH=%s\n' 'false'
    printf 'OAUTH2_PROXY_PASS_USER_HEADERS=%s\n' 'false'
    printf 'OAUTH2_PROXY_COOKIE_NAME=%s\n' '__Host-security_portal'
    printf 'OAUTH2_PROXY_COOKIE_SECURE=%s\n' 'true'
    printf 'OAUTH2_PROXY_COOKIE_HTTPONLY=%s\n' 'true'
    printf 'OAUTH2_PROXY_COOKIE_SAMESITE=%s\n' 'lax'
    printf 'OAUTH2_PROXY_COOKIE_EXPIRE=%s\n' '8h'
    printf 'OAUTH2_PROXY_COOKIE_REFRESH=%s\n' '1h'
    printf 'OAUTH2_PROXY_SESSION_COOKIE_MINIMAL=%s\n' 'false'
    printf 'OAUTH2_PROXY_SKIP_PROVIDER_BUTTON=%s\n' 'true'
    printf 'OAUTH2_PROXY_SHOW_DEBUG_ON_ERROR=%s\n' 'false'
    printf 'OAUTH2_PROXY_SILENCE_PING_LOGGING=%s\n' 'true'
  } > "$INSTALL_DIR/oauth2-proxy.env"
else
  {
    printf '%s\n' '# oauth2-proxy is disabled unless COMPOSE_PROFILES=oidc'
  } > "$INSTALL_DIR/oauth2-proxy.env"
fi
chmod 600 "$INSTALL_DIR/oauth2-proxy.env"
OIDC_SECRET_JSON=""
unset OIDC_CLIENT_SECRET OIDC_COOKIE_SECRET COOKIE_SECRET_STANDARD_B64

if [ "$ENABLE_VAULT_DIRECT" = "true" ]; then
  for vault_secret_id in "$VAULT_ROLE_ID_SECRET_ID" "$VAULT_SECRET_ID_SECRET_ID"; do
    if ! aws secretsmanager get-secret-value \
      --region "$REGION" \
      --secret-id "$vault_secret_id" \
      --query ARN \
      --output text \
      >/dev/null; then
      echo "The portal EC2 role cannot read a required Vault AppRole secret" >&2
      exit 1
    fi
  done

  VAULT_HEALTH_CODE="$(curl -sS \
    --connect-timeout "$VAULT_TIMEOUT_SECONDS" \
    --max-time "$VAULT_TIMEOUT_SECONDS" \
    -o /dev/null \
    -w '%{http_code}' \
    "$VAULT_ADDR/v1/sys/health" || true)"
  case "$VAULT_HEALTH_CODE" in
    200|429|472|473|501|503) ;;
    *)
      echo "Vault health endpoint is not reachable from the portal host" >&2
      exit 1
      ;;
  esac
fi

elastic_ready=false
for attempt in $(seq 1 60); do
  if curl -fsS -u "$ELASTIC_USERNAME:$ELASTIC_PASSWORD" http://127.0.0.1:9200/_cluster/health >/dev/null 2>&1; then
    elastic_ready=true
    break
  fi
  sleep 2
done
if [ "$elastic_ready" != "true" ]; then
  echo "Elasticsearch did not become ready for Filebeat provisioning" >&2
  exit 1
fi

if [ "$ENABLE_ELASTIC_PEER_PROXY" = "true" ]; then
  PRIVATE_IP="$(hostname -I | awk '{print $1}')"
  if [ -z "$PRIVATE_IP" ]; then
    echo "Unable to determine the Elastic host private IP" >&2
    exit 1
  fi
  if [ ! -x /lib/systemd/systemd-socket-proxyd ]; then
    echo "systemd-socket-proxyd is unavailable" >&2
    exit 1
  fi

  {
    printf '%s\n' '[Unit]'
    printf '%s\n' 'Description=Private VPC listener for Elasticsearch'
    printf '%s\n' 'After=network-online.target elastic-siem.service'
    printf '\n'
    printf '%s\n' '[Socket]'
    printf 'ListenStream=%s:9200\n' "$PRIVATE_IP"
    printf '%s\n' 'NoDelay=true'
    printf '\n'
    printf '%s\n' '[Install]'
    printf '%s\n' 'WantedBy=sockets.target'
  } > /etc/systemd/system/elastic-peer-proxy.socket

  {
    printf '%s\n' '[Unit]'
    printf '%s\n' 'Description=Private VPC proxy to loopback Elasticsearch'
    printf '%s\n' 'Requires=elastic-siem.service'
    printf '%s\n' 'After=elastic-siem.service'
    printf '\n'
    printf '%s\n' '[Service]'
    printf '%s\n' 'ExecStart=/lib/systemd/systemd-socket-proxyd 127.0.0.1:9200'
    printf '%s\n' 'NoNewPrivileges=true'
    printf '%s\n' 'PrivateDevices=true'
    printf '%s\n' 'PrivateTmp=true'
    printf '%s\n' 'ProtectHome=true'
    printf '%s\n' 'ProtectSystem=strict'
    printf '%s\n' 'RestrictAddressFamilies=AF_INET AF_INET6'
    printf '%s\n' 'RestrictNamespaces=true'
  } > /etc/systemd/system/elastic-peer-proxy.service

  systemctl daemon-reload
  systemctl enable --now elastic-peer-proxy.socket
  curl -fsS -u "$ELASTIC_USERNAME:$ELASTIC_PASSWORD" "http://$PRIVATE_IP:9200/_cluster/health" >/dev/null
fi

filebeat_key_ready=false
if [ -n "$FILEBEAT_API_KEY" ]; then
  PRIVILEGE_RESPONSE="$(
    curl -sS \
      -H "Authorization: ApiKey $FILEBEAT_API_KEY" \
      -H 'Content-Type: application/json' \
      -X POST http://127.0.0.1:9200/_security/user/_has_privileges \
      -d '{"cluster":["monitor"],"index":[{"names":["filebeat-security-lab-*"],"privileges":["auto_configure","create_doc","view_index_metadata"]}]}'
  )"
  if printf '%s' "$PRIVILEGE_RESPONSE" | jq -e '.has_all_requested == true' >/dev/null 2>&1; then
    filebeat_key_ready=true
  fi
fi

if [ "$filebeat_key_ready" != "true" ]; then
  curl -fsS \
    -u "$ELASTIC_USERNAME:$ELASTIC_PASSWORD" \
    -H 'Content-Type: application/json' \
    -X DELETE http://127.0.0.1:9200/_security/api_key \
    -d '{"name":"ibm-hc-lab-filebeat-ingest"}' \
    >/dev/null
  KEY_RESPONSE="$(
    curl -fsS \
      -u "$ELASTIC_USERNAME:$ELASTIC_PASSWORD" \
      -H 'Content-Type: application/json' \
      -X POST http://127.0.0.1:9200/_security/api_key \
      -d '{"name":"ibm-hc-lab-filebeat-ingest","role_descriptors":{"filebeat-ingest":{"cluster":["monitor"],"index":[{"names":["filebeat-security-lab-*"],"privileges":["auto_configure","create_doc","view_index_metadata"]}]}}}'
  )"
  FILEBEAT_API_KEY="$(printf '%s' "$KEY_RESPONSE" | jq -r '.encoded // empty')"
  if [ -z "$FILEBEAT_API_KEY" ]; then
    echo "Failed to create the Filebeat ingest API key" >&2
    exit 1
  fi

  SECRET_JSON="$(printf '%s' "$SECRET_JSON" | jq --arg key "$FILEBEAT_API_KEY" '.elastic_filebeat_ingest_api_key = $key')"
  SECRET_CHANGED=true
fi

filebeat_read_key_ready=false
if [ -n "$FILEBEAT_READ_API_KEY" ]; then
  PRIVILEGE_RESPONSE="$(
    curl -sS \
      -H "Authorization: ApiKey $FILEBEAT_READ_API_KEY" \
      -H 'Content-Type: application/json' \
      -X POST http://127.0.0.1:9200/_security/user/_has_privileges \
      -d '{"index":[{"names":["filebeat-security-lab-*"],"privileges":["read","view_index_metadata"]}]}'
  )"
  if printf '%s' "$PRIVILEGE_RESPONSE" | jq -e '.has_all_requested == true' >/dev/null 2>&1; then
    filebeat_read_key_ready=true
  fi
fi

if [ "$filebeat_read_key_ready" != "true" ]; then
  curl -fsS \
    -u "$ELASTIC_USERNAME:$ELASTIC_PASSWORD" \
    -H 'Content-Type: application/json' \
    -X DELETE http://127.0.0.1:9200/_security/api_key \
    -d '{"name":"ibm-hc-lab-filebeat-read"}' \
    >/dev/null
  KEY_RESPONSE="$(
    curl -fsS \
      -u "$ELASTIC_USERNAME:$ELASTIC_PASSWORD" \
      -H 'Content-Type: application/json' \
      -X POST http://127.0.0.1:9200/_security/api_key \
      -d '{"name":"ibm-hc-lab-filebeat-read","role_descriptors":{"filebeat-read":{"cluster":[],"index":[{"names":["filebeat-security-lab-*"],"privileges":["read","view_index_metadata"]}]}}}'
  )"
  FILEBEAT_READ_API_KEY="$(printf '%s' "$KEY_RESPONSE" | jq -r '.encoded // empty')"
  if [ -z "$FILEBEAT_READ_API_KEY" ]; then
    echo "Failed to create the Filebeat read API key" >&2
    exit 1
  fi

  SECRET_JSON="$(printf '%s' "$SECRET_JSON" | jq --arg key "$FILEBEAT_READ_API_KEY" '.elastic_filebeat_read_api_key = $key')"
  SECRET_CHANGED=true
fi

if [ "$SECRET_CHANGED" = "true" ]; then
  SECRET_FILE="$(mktemp)"
  chmod 600 "$SECRET_FILE"
  printf '%s' "$SECRET_JSON" > "$SECRET_FILE"
  aws secretsmanager put-secret-value \
    --region "$REGION" \
    --secret-id "$ELASTIC_SECRET_ID" \
    --secret-string "file://$SECRET_FILE" \
    >/dev/null
  rm -f "$SECRET_FILE"
  SECRET_FILE=""
fi

FILEBEAT_CONFIG_API_KEY="$(printf '%s' "$FILEBEAT_API_KEY" | base64 -d 2>/dev/null || true)"
case "$FILEBEAT_CONFIG_API_KEY" in
  *:*) ;;
  *)
    echo "Filebeat API key is not a valid encoded id:key pair" >&2
    exit 1
    ;;
esac

{
  printf 'ELASTIC_URL=%s\n' 'http://127.0.0.1:9200'
  printf 'ELASTIC_READ_API_KEY=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_read_api_key // empty')"
  printf 'ELASTIC_VERIFY_TLS=%s\n' 'false'
  printf 'ELASTIC_DS_VAULT_AUDIT=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_data_streams.vault_audit // "logs-hashicorp_vault.audit-lab"')"
  printf 'ELASTIC_DS_PGAUDIT=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_data_streams.pgaudit // "logs-postgresql.pgaudit-lab"')"
  printf 'ELASTIC_DS_VAULT_RADAR=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_data_streams.vault_radar // "logs-hashicorp_vault_radar.findings-lab"')"
  printf 'ELASTIC_DS_FILEBEAT=%s\n' 'filebeat-security-lab-*'
  printf 'ELASTIC_FILEBEAT_READ_API_KEY=%s\n' "$FILEBEAT_READ_API_KEY"
  printf 'ELASTIC_DS_OPENCOST=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_data_streams.opencost // "metrics-opencost.summary-lab"')"
  printf 'ELASTIC_OPENCOST_READ_API_KEY=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_opencost_read_api_key // empty')"
  printf 'ELASTIC_DS_APPLICATION_RISK=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_data_streams.application_risk // "logs-security_application.risk-lab"')"
  printf 'ELASTIC_APPLICATION_RISK_READ_API_KEY=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.elastic_application_risk_read_api_key // empty')"
  printf 'EKS_CLUSTER_NAME=%s\n' 'ibm-hc-lab-test-eks'
  printf 'KIBANA_URL=%s\n' "$(printf '%s' "$SECRET_JSON" | jq -r '.kibana_url // empty')"
  printf 'GRAFANA_URL=%s\n' '__GRAFANA_URL__'
  printf 'PROMETHEUS_URL=%s\n' '__PROMETHEUS_URL__'
  printf 'LOKI_URL=%s\n' '__LOKI_URL__'
  printf 'TEMPO_URL=%s\n' '__TEMPO_URL__'
  printf 'PORTAL_AUTH_MODE=%s\n' "$BACKEND_AUTH_MODE"
  printf 'CASE_DB_PATH=%s\n' '/var/lib/security-portal/cases.db'
  if [ "$ENABLE_VAULT_DIRECT" = "true" ]; then
    printf 'VAULT_ADDR=%s\n' "$VAULT_ADDR"
    printf 'VAULT_AUTH_METHOD=%s\n' 'approle'
    printf 'VAULT_APPROLE_ROLE_ID_SECRET_ID=%s\n' "$VAULT_ROLE_ID_SECRET_ID"
    printf 'VAULT_APPROLE_SECRET_ID_SECRET_ID=%s\n' "$VAULT_SECRET_ID_SECRET_ID"
    printf 'VAULT_AWS_REGION=%s\n' "$REGION"
    printf 'VAULT_NAMESPACE=%s\n' "$VAULT_NAMESPACE"
    printf 'VAULT_APPROLE_AUTH_MOUNT=%s\n' "$VAULT_APPROLE_AUTH_MOUNT"
    printf 'VAULT_PKI_MOUNT=%s\n' "$VAULT_PKI_MOUNT"
    printf 'VAULT_LEASE_PREFIX=%s\n' "$VAULT_LEASE_PREFIX"
    printf 'VAULT_TIMEOUT_SECONDS=%s\n' "$VAULT_TIMEOUT_SECONDS"
  else
    printf 'VAULT_ADDR=%s\n' ''
    printf 'VAULT_AUTH_METHOD=%s\n' 'none'
  fi
  printf 'AI_ASSISTANT_PROVIDER=%s\n' '__AI_ASSISTANT_PROVIDER__'
  printf 'AI_ASSISTANT_MODEL_ID=%s\n' '__AI_ASSISTANT_MODEL_ID__'
  printf 'AI_ASSISTANT_REGION=%s\n' '__AI_ASSISTANT_REGION__'
  printf 'AI_ASSISTANT_MAX_TOKENS=%s\n' '__AI_ASSISTANT_MAX_TOKENS__'
} > "$INSTALL_DIR/backend.env"
chmod 600 "$INSTALL_DIR/backend.env"

{
  printf 'ELASTIC_FILEBEAT_URL=%s\n' 'http://127.0.0.1:9200'
  printf 'ELASTIC_FILEBEAT_API_KEY=%s\n' "$FILEBEAT_CONFIG_API_KEY"
} > "$INSTALL_DIR/filebeat.env"
chmod 600 "$INSTALL_DIR/filebeat.env"
unset FILEBEAT_CONFIG_API_KEY

if [ "$PORTAL_AUTH_MODE" = "oidc" ]; then
  docker pull quay.io/oauth2-proxy/oauth2-proxy:v7.15.3 >/dev/null
  docker run --rm \
    --user 65532:65532 \
    --env-file "$INSTALL_DIR/oauth2-proxy.env" \
    --mount "type=bind,src=$INSTALL_DIR/secrets/oidc-client-secret,dst=/run/secrets/oidc-client-secret,readonly" \
    --mount "type=bind,src=$INSTALL_DIR/secrets/oidc-cookie-secret,dst=/run/secrets/oidc-cookie-secret,readonly" \
    quay.io/oauth2-proxy/oauth2-proxy:v7.15.3 \
    --config-test
fi

docker pull nginx:1.27-alpine >/dev/null
docker run --rm \
  --entrypoint nginx \
  --mount "type=bind,src=$INSTALL_DIR/nginx.conf,dst=/etc/nginx/conf.d/default.conf,readonly" \
  nginx:1.27-alpine \
  -t

COMPOSE_PROFILES="$COMPOSE_PROFILES" docker compose -f "$INSTALL_DIR/docker-compose.yml" config --quiet

{
  printf '%s\n' '[Unit]'
  printf '%s\n' 'Description=Information Security Portal'
  printf '%s\n' 'Requires=docker.service'
  printf '%s\n' 'After=docker.service network-online.target elastic-siem.service'
  printf '\n'
  printf '%s\n' '[Service]'
  printf '%s\n' 'Type=oneshot'
  printf '%s\n' 'RemainAfterExit=yes'
  printf 'WorkingDirectory=%s\n' "$INSTALL_DIR"
  printf 'Environment=PORTAL_PORT=%s\n' "$PORTAL_PORT"
  printf 'Environment=COMPOSE_PROFILES=%s\n' "$COMPOSE_PROFILES"
  printf '%s\n' 'ExecStart=/usr/bin/docker compose up -d --build --force-recreate'
  printf '%s\n' 'ExecStop=/usr/bin/docker compose down'
  printf '%s\n' 'TimeoutStartSec=0'
  printf '\n'
  printf '%s\n' '[Install]'
  printf '%s\n' 'WantedBy=multi-user.target'
} > /etc/systemd/system/security-portal.service

systemctl daemon-reload
systemctl enable security-portal
systemctl restart security-portal
COMPOSE_PROFILES="$COMPOSE_PROFILES" docker compose -f "$INSTALL_DIR/docker-compose.yml" ps
attempt=1
while [ "$attempt" -le 30 ]; do
  oauth2_ready=true
  if [ "$PORTAL_AUTH_MODE" = "oidc" ]; then
    oauth2_ready=false
    if COMPOSE_PROFILES="$COMPOSE_PROFILES" docker compose -f "$INSTALL_DIR/docker-compose.yml" ps --status running --services | grep -qx oauth2-proxy \
      && COMPOSE_PROFILES="$COMPOSE_PROFILES" docker compose -f "$INSTALL_DIR/docker-compose.yml" exec -T frontend \
        wget -q -O /dev/null http://oauth2-proxy:4180/ping; then
      oauth2_ready=true
    fi
  fi
  if curl -fsS "http://127.0.0.1:$PORTAL_PORT/health" >/dev/null \
    && COMPOSE_PROFILES="$COMPOSE_PROFILES" docker compose -f "$INSTALL_DIR/docker-compose.yml" ps --status running --services | grep -qx filebeat \
    && [ "$oauth2_ready" = "true" ]; then
    exit 0
  fi
  attempt=$((attempt + 1))
  sleep 2
done

COMPOSE_PROFILES="$COMPOSE_PROFILES" docker compose -f "$INSTALL_DIR/docker-compose.yml" logs --tail=120
exit 1
