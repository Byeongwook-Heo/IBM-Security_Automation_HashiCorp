aws_region = "us-east-1"
name_prefix = "ibm-hc-lab"
enable_modules = true
# qradar_api_token = set via TF_VAR_qradar_api_token, never commit real values

# Terraform Enterprise stays disabled until secret ARNs and an explicit restricted
# administrator CIDR are supplied through a non-tracked tfvars file or TF_VAR_*.
enable_terraform_enterprise                    = false
terraform_enterprise_alb_allowed_cidr_blocks   = []
# terraform_enterprise_license_secret_arn = "arn:aws:secretsmanager:..."
# terraform_enterprise_encryption_password_secret_arn = "arn:aws:secretsmanager:..."

# StackStorm remains a review-only, private EC2 scaffold. It is disabled until a
# private subnet and an existing SSM-enabled instance profile are supplied.
enable_stackstorm_runner = false
# stackstorm_runner_subnet_id = "subnet-..."
# stackstorm_runner_iam_instance_profile_name = "existing-ssm-instance-profile"
# stackstorm_runner_review_access_cidr_blocks = ["203.0.113.10/32"]

enterprise_image_uris = {
  qradar      = ""
  guardium    = ""
  instana     = ""
  turbonomic  = ""
  kubecost    = ""
  concert     = ""
  vault       = ""
  boundary    = ""
  nomad       = ""
}
# enterprise_license_secret_arns and enterprise_license_vault_paths must be supplied securely outside git.
